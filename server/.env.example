PORT=4007
CLIENT_URL=http://localhost:4006
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...

# 로컬 dev 인증 바이패스 — true면 (NODE_ENV !== 'production' 조건 하에)
# JWT 없는/무효한 요청을 실제 Supabase의 dev 유저(dev@curriculum-weaver.local)로 처리.
# 클라이언트 placeholder 모드(VITE_SUPABASE_URL=placeholder)와 로컬 E2E용. 프로덕션 금지.
# DEV_AUTH_BYPASS=true

# 가입 승인 요청 메일 알림 (선택) — 둘 다 있어야 보낸다. 설정 방법: docs/승인-요청-메일-알림.md
# 구글 Apps Script 웹 앱 주소와, 그 스크립트에 적어 둔 것과 같은 비밀 문자열
APPROVAL_NOTIFY_WEBHOOK_URL=
APPROVAL_NOTIFY_SECRET=
